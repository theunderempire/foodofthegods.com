{
  "name": "foodofthegods-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "swagger": "node swagger.js",
    "start": "NODE_ENV=production PORT=3000 node ./bin/www.js",
    "start-dev": "NODE_ENV=development PORT=3000 nodemon --watch src --watch ./bin/www.js  ./bin/www.js",
    "test": "node --test",
    "backfill-thumbnails": "node scripts/backfill-thumbnails.js",
    "deploy": "cd ../ && docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build -V fotg-api",
    "lint": "eslint src test",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.18.2",
    "debug": "~2.6.9",
    "dotenv": "^8.2.0",
    "express": "^4.15.5",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "monk": "^7.3.4",
    "morgan": "^1.9.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "swagger-autogen": "^2.23.7"
  }
}
