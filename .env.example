# MongoDB + API
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST_NAME=

# API
# Must be at least 32 characters — the API refuses to start otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Number of reverse proxies in front of the API. Rate limits key on client IP, so
# this must be 1 when running behind Caddy, or every user shares one bucket.
TRUST_PROXY_HOPS=0

# Note: there is no server-wide Gemini key. Each user supplies their own in
# Settings, stored on their user record.

# URLs used in registration emails (no trailing slash)
APP_URL=https://theunderempire.com/foodofthegods
VITE_API_BASE_URL=https://theunderempire.com/foodofthegods-api

# SMTP (for registration emails)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to false only if using a self-signed cert
SMTP_REJECT_UNAUTHORIZED=true
